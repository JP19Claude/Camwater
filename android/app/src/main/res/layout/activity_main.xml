<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camwater"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Hauptschalter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/autoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Watermark AUS"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/autoSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:scaleX="1.25"
                    android:scaleY="1.25" />
            </LinearLayout>

            <TextView
                android:id="@+id/autoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/batteryButton"
                style="@style/Widget.Camwater.Button.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Im Hintergrund zuverlässig laufen lassen (empfohlen)"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Vorschau -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="1dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Vorschau mit Watermark"
                android:maxHeight="520dp"
                android:minHeight="160dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/previewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="Beispielbild"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </FrameLayout>

        <Button
            android:id="@+id/pickButton"
            style="@style/Widget.Camwater.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fotos aus der Galerie bearbeiten" />

        <LinearLayout
            android:id="@+id/progressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Vorlagen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Camwater.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Watermark wählen" />

            <Button
                android:id="@+id/editButton"
                style="@style/Widget.Camwater.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bearbeiten" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/presetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="+ Eigene Marke / eigenes Handy hinzufügen"
            android:textColor="@color/accent" />

        <!-- Einstellungen -->
        <TextView
            style="@style/Widget.Camwater.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Einstellungen" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fertige Fotos speichern in"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/folderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/folderAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Eigenes Album „Camwater“"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/folderCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Kamera-Ordner (neben dem Original)"
                    android:textColor="@color/text" />
            </RadioGroup>

            <Switch
                android:id="@+id/exifSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Fotodaten behalten (Datum, Ort, Kamera)"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingMultiplier="1.2"
            android:text="So geht es: Schalter oben an, dann ganz normal mit der Samsung-Kamera fotografieren. Camwater speichert von jedem neuen Foto eine Kopie mit Watermark. Das Original bleibt unverändert.\n\nAlte Fotos bearbeitest du mit dem gelben Knopf oder in der Galerie über Teilen → Camwater.\n\nLogos werden als Schrift nachgebaut. Marken- und Logonamen gehören ihren Inhabern; Camwater hat nichts mit diesen Firmen zu tun."
            android:textColor="@color/muted"
            android:textSize="12.5sp" />
    </LinearLayout>
</ScrollView>
